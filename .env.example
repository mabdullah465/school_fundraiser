APP_NAME="School Fundraiser"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_fundraiser
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Shopify ---------------------------------------------------------------
# Store this backend serves, e.g. my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2025-10
# Custom app Admin API token (shpat_...). Only needed for shopify:register-webhooks.
SHOPIFY_ADMIN_TOKEN=
# App credentials (Dev Dashboard). If SHOPIFY_ADMIN_TOKEN is empty, a token is fetched with these.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# The custom app's "API secret key". Used to verify webhook signatures.
# Webhooks are rejected while this is empty. The value below is for LOCAL dummy testing only.
SHOPIFY_WEBHOOK_SECRET=local-dev-webhook-secret
# Cart attribute the theme writes the school id into.
SHOPIFY_SCHOOL_ATTRIBUTE=school_id

# Browser origins allowed to call /api/v1/storefront/* (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:9292,https://my-store.myshopify.com

# --- Donations -------------------------------------------------------------
DONATION_HOLD_DAYS=14
DONATION_EXCLUDED_PRODUCT_IDS=

# --- Dashboard page at / ---
# Leave DASHBOARD_PASSWORD empty for an open page. Set it to require HTTP Basic login.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
